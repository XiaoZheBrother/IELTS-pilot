{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IELTS Pilot",
  "version": "0.5.0",
  "identifier": "com.xiaozhebrother.ieltspilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IELTS Pilot",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "XiaoZheBrother",
    "shortDescription": "Local-first IELTS reading practice studio",
    "longDescription": "IELTS Pilot provides local reading practice, review, annotations, error recovery and content package authoring.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
